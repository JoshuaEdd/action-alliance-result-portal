# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ahiazu_federal_constituency

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30m
OTP_TTL_MINUTES=5

# Rate limiting (SEC brute-force protection, FR-1.4)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# File uploads (SEC-8, SEC-9)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# GPS geofence check (SEC-7)
GPS_FLAG_RADIUS_METERS=500
